# Variables de entorno — Ejemplo. Copiar a .env y completar. NO versionar .env.

# ------------------------------------------------------------------------------
# BACKEND
# Variables para el servidor (API / workers).
# Ninguna de estas debe exponerse al bundle del cliente.
# ------------------------------------------------------------------------------

# Entorno de ejecucion: development | test | production
NODE_ENV=

# Puerto en el que escucha la API
PORT=

# Cadena de conexion a PostgreSQL (Neon). Solo credenciales en entorno, nunca en el repo.
DATABASE_URL=

# Conexion directa a Postgres, solo para migraciones de Prisma
DIRECT_URL=

# Redis para cache y colas (BullMQ)
REDIS_URL=

# Secreto de firma de tokens JWT de acceso. TODO: generar con generador criptografico, minimo 32 bytes
JWT_ACCESS_SECRET=

# Secreto de firma de tokens JWT de refresco. TODO: generar aparte, nunca igual al de acceso
JWT_REFRESH_SECRET=

# Vida del token de acceso (ej. 15m, 1h)
JWT_ACCESS_TTL=

# Vida del token de refresco (ej. 7d, 30d)
JWT_REFRESH_TTL=

# Llave publica de Wompi. TODO: llaves de sandbox hasta activar produccion;
# la cuenta de comercio se crea al final del proyecto
WOMPI_PUBLIC_KEY=

# Secreto para verificar la firma de webhooks de Wompi
WOMPI_EVENTS_SECRET=

# Secreto de integridad de Wompi
WOMPI_INTEGRITY_SECRET=

# Entorno de Wompi: sandbox | production
WOMPI_ENVIRONMENT=

# Origenes permitidos por CORS, separados por comas. Ej. http://localhost:3000
CORS_ORIGINS=

# Ventana y maximo de peticiones para endpoints sensibles (login, checkout, webhooks).
# TODO: definir limites por endpoint
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX_REQUESTS=

# Nivel de log: error | warn | info | debug
LOG_LEVEL=

# ------------------------------------------------------------------------------
# FRONTEND
# Variables expuestas al cliente (Next.js).
# ------------------------------------------------------------------------------
# NOTA: al frontend SOLO llegan las variables NEXT_PUBLIC_*.
# Cualquier otra variable del backend nunca debe exponerse al bundle del cliente,
# porque quedaria expuesta de forma publica. Ante la duda, no la expongas.
# ------------------------------------------------------------------------------

# URL base de la API publica
NEXT_PUBLIC_API_URL=

# Nombre de marca configurable (nunca hardcodeado en el codigo)
NEXT_PUBLIC_BRAND_NAME=

# Eslogan de la marca. TODO: definir texto real
NEXT_PUBLIC_BRAND_TAGLINE=

# Redes sociales. TODO: definir URLs reales
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_TIKTOK=

# ------------------------------------------------------------------------------
# MARCA BLANCA
# Identidad de la tienda como configuracion, para poder rebrandear sin tocar codigo.
# Estos valores son la fuente de verdad de la identidad; en una implementacion con
# tabla Settings en base de datos, pueden sobreescribirse desde el panel admin.
# ------------------------------------------------------------------------------

# Nombre completo de la marca
BRAND_NAME_FULL=

# Descripcion corta de la marca. TODO: definir texto
BRAND_DESCRIPTION_SHORT=

# Rutas o URLs del logotipo (principal e invertido para fondo oscuro)
BRAND_LOGO_PRIMARY=
BRAND_LOGO_INVERTED=

# Paleta de marca. TODO: definir paleta exacta
BRAND_COLOR_PRIMARY=
BRAND_COLOR_ACCENT=
BRAND_COLOR_BACKGROUND=
BRAND_COLOR_TEXT=

# Datos de la tienda. TODO: definir datos reales del negocio
STORE_NAME=
STORE_ADDRESS=
STORE_CITY=
STORE_COUNTRY=

# Soporte al cliente. TODO: datos reales del negocio
SUPPORT_EMAIL=
SUPPORT_PHONE=

# Legal (Ley 1581 de Colombia). TODO: definir textos legales definitivos
LEGAL_PRIVACY_URL=
LEGAL_TERMS_URL=