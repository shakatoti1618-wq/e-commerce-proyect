{
  "name": "@lume/backend",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node -e \"process.env.NODE_ENV ??= 'production'; require('./dist/main.js')\"",
    "start:dev": "tsc -p tsconfig.build.json && node -e \"process.env.NODE_ENV ??= 'development'; require('./dist/main.js')\"",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "nestjs-pino": "5.3.1",
    "nestjs-zod": "5.5.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@types/node": "24.19.0",
    "supertest": "7.3.1",
    "typescript": "5.9.2",
    "vitest": "5.0.3"
  }
}
