{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "deny",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git push*": "deny",
      "pnpm install": "allow",
      "pnpm install --frozen-lockfile": "allow",
      "pnpm test*": "allow",
      "pnpm lint*": "allow",
      "pnpm build*": "allow",
      "pnpm typecheck*": "allow",
      "pnpm prisma generate*": "allow"
    },
    "skill": {
      "*": "deny"
    }
  }
}
